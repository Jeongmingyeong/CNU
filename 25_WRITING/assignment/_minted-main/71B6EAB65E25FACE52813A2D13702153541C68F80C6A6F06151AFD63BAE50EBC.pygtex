\begin{Verbatim}[commandchars=\\\{\}]
\PYG{k}{def} \PYG{n+nf}{foo}\PYG{p}{(}\PYG{n}{a}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,} \PYG{n}{b}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{):}
    \PYG{k}{return} \PYG{n}{a} \PYG{o}{+} \PYG{n}{b}

\PYG{c+c1}{\PYGZsh{} No Error}
\PYG{n}{a} \PYG{o}{=} \PYG{n}{foo}\PYG{p}{(}\PYG{l+m+mi}{1}\PYG{p}{,} \PYG{l+m+mi}{2}\PYG{p}{)}

\PYG{c+c1}{\PYGZsh{} TypeError only in static type checker}
\PYG{n}{b} \PYG{o}{=} \PYG{n}{foo}\PYG{p}{(}\PYG{l+m+mi}{2}\PYG{p}{,} \PYG{l+m+mf}{3.14}\PYG{p}{)}

\PYG{c+c1}{\PYGZsh{} TypeError in both static type checker and runtime}
\PYG{n}{c} \PYG{o}{=} \PYG{n}{foo}\PYG{p}{(}\PYG{l+m+mi}{3}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{}hello\PYGZdq{}}\PYG{p}{)}
\end{Verbatim}
